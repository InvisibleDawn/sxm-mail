{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXM Mail",
  "version": "0.2.1",
  "identifier": "app.sxmmail.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SXM Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Client mail multi-comptes",
    "longDescription": "Client mail de bureau avec inbox unifiée et tri intelligent : Gmail, Office 365, Hotmail.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "license": "MIT"
  }
}